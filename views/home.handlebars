<div>
    <ul>
        <div class="produtos">
            <li>
                {{#each produtos}}
                    <h3>{{name}}</h3>
                    <p>Descrição: {{product_description}}</p>
                    <p>INVESTIMENTO DE R${{price}}</p>
                    <!-- Passa o ID do produto dinamicamente na URL -->
                    <a href="/produto/{{id}}"><button>ADQUIRIR AGORA</button></a>
                {{/each}}
            </li>
        </div>
    </ul>
</div>