<main>
    <section>
        <ul class="produtos-container">
            {{#each produtos}}
            <li class="produtos">
                <h3>{{name}}</h3>
                <p>Descrição: {{product_description}}</p>
                <p class="price">INVESTIMENTO DE R${{price}}</p>
                <a href="/produto/{{id}}"><button>ADQUIRIR AGORA</button></a>
            </li>
            {{/each}}
        </ul>
    </section>
</main>